# Copy to .env.local and fill in from Supabase > Project settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Emails (server only). Without RESEND_API_KEY, confirmation emails are skipped and logged instead.
RESEND_API_KEY=
EMAIL_FROM="Hikmah Institute <no-reply@hikmahinstitute.org.pk>"
# Optional: logo for emails. Defaults to NEXT_PUBLIC_SITE_URL/logo.png once deployed.
EMAIL_LOGO_URL=
# Who gets an email when someone submits Mentorship, Hikmah at Work or Hifz (comma separated)
REQUESTS_NOTIFY_EMAIL=info@hikmahinstitute.org.pk
